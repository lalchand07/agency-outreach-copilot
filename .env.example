# agency-outreach-copilot configuration.
# Copy to .env and fill in. Secrets live ONLY here: never in the database, never in Git.

APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Europe/London
# "production" turns on Secure cookies (HTTPS) and hides error details.
APP_ENV=local

# Admin login. Create the hash with:  php bin/console hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Long random string used to sign unsubscribe links. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# Database: sqlite (default) or mysql
DB_DRIVER=sqlite
DB_PATH=var/app.sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=outreach
# DB_USER=outreach
# DB_PASSWORD=

# --- AI (all calls go through php-ai-guard) ---------------------------------
# Set at least one key. Tiers list "provider:model" in fallback order.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_CHEAP_MODELS=anthropic:claude-haiku-5-5
AI_STANDARD_MODELS=anthropic:claude-sonnet-5-5,anthropic:claude-haiku-5-5
# Hard spending limits in USD. Calls are refused before they are sent if they could exceed them.
AI_MONTHLY_BUDGET_USD=10
AI_DAILY_BUDGET_USD=
# Optional: your own copy of the pricing table (USD per 1M tokens). Verify the numbers!
AI_PRICING_FILE=config/ai-pricing.php

# --- Google Places API (New), your own key ------------------------------------
# Restrict the key to "Places API (New)" and to your server's IP in Google Cloud.
GOOGLE_PLACES_API_KEY=

# --- Website research ---------------------------------------------------------
# A URL or email where site owners can reach you; it goes into the User-Agent.
CRAWLER_CONTACT=https://example.com/bot
CRAWLER_TIMEOUT=10
CRAWLER_MIN_DELAY_MS=1000

# --- SMTP (PHPMailer) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS), ssl (SMTPS) or none
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional mailbox that receives replies (defaults to the sender email in config/product.php)
SMTP_REPLY_TO=
